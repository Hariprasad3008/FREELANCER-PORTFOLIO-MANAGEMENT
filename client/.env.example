# Local Development (leave empty or use relative /api with Vite dev proxy):
# VITE_API_URL=/api
# VITE_SOCKET_URL=http://localhost:5000

# Production on Vercel / Netlify (replace with your deployed backend URL):
# VITE_API_URL=https://your-backend-url.onrender.com/api
# VITE_SOCKET_URL=https://your-backend-url.onrender.com

VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5000
