PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-app.vercel.app
JWT_SECRET=super_secret_jwt_key_freelancer_marketplace_2026_secure

# Supabase / Cloud PostgreSQL Connection String
# Direct connection (Session mode):
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# Transaction Pooler (recommended for serverless/containers):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelancer_db

# Optional Supabase storage / auth keys if used:
SUPABASE_URL=
SUPABASE_ANON_KEY=
